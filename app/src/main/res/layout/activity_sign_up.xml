<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    tools:context=".SignUpActivity">

    <!-- ================= HEADER SECTION ================= -->

    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="30dp"
        android:src="@drawable/ic_back_arrow"
        app:tint="#FFFFFF"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvBrand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TutorNav"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/btnBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btnBack" />

    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="24dp"
        android:src="@drawable/logo_atom"
        app:layout_constraintBottom_toBottomOf="@+id/btnBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btnBack" />

    <!-- ================= MAIN FORM CARD ================= -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="30dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="20dp"
        app:cardBackgroundColor="#44000000"
        app:cardCornerRadius="35dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvBrand">

        <!-- ScrollView added so the keyboard doesn't hide inputs -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">

                <!-- Title -->
                <TextView
                    android:id="@+id/tvSignUpTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sign Up"
                    android:textColor="#FFFFFF"
                    android:textSize="34sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- "Sign In instead" Row -->
                <LinearLayout
                    android:id="@+id/signInRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="15dp"
                    app:layout_constraintTop_toBottomOf="@id/tvSignUpTitle"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="or Sign In instead"
                        android:textColor="#B0B0B0"
                        android:textSize="12sp"
                        android:layout_marginEnd="10dp"/>

                    <!-- Small Dark Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGoToSignIn"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Sign In"
                        android:textColor="#9FA8DA"
                        android:textAllCaps="false"
                        android:textSize="12sp"
                        android:backgroundTint="#1F1B33"
                        app:cornerRadius="15dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"/>
                </LinearLayout>

                <!-- Social Section -->
                <TextView
                    android:id="@+id/tvSocialLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="or Sign Up with third Party"
                    android:textColor="#B0B0B0"
                    android:textSize="12sp"
                    android:layout_marginTop="20dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/signInRow" />

                <!-- ================= SOCIAL LOGIN SECTION ================= -->
                <LinearLayout
                    android:id="@+id/socialContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="15dp"
                    app:layout_constraintTop_toBottomOf="@id/tvSocialLabel"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <TextView
                        android:id="@+id/btnGoogle"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_circle_dark"
                        android:gravity="center"
                        android:text="G"
                        android:textColor="#A0A0A0"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/btnFacebook"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_circle_dark"
                        android:gravity="center"
                        android:text="FB"
                        android:textColor="#A0A0A0"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/btnYahoo"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_circle_dark"
                        android:gravity="center"
                        android:text="Y!"
                        android:textColor="#A0A0A0"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true"/>

                    <!-- Apple (A) button -->
                    <TextView
                        android:id="@+id/btnApple"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_circle_dark"
                        android:gravity="center"
                        android:text="A"
                        android:textColor="#A0A0A0"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvDetailsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="or with Phone / Email"
                    android:textColor="#B0B0B0"
                    android:textSize="12sp"
                    android:layout_marginTop="20dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/socialContainer" />

                <!-- ================= INPUT FIELDS ================= -->

                <!-- 1. Name -->
                <EditText
                    android:id="@+id/etName"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="15dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="Full Name"
                    android:textColorHint="#5C5670"
                    android:textColor="#FFFFFF"
                    android:paddingStart="16dp"
                    android:inputType="textPersonName|textCapWords"
                    android:textSize="14sp"
                    app:layout_constraintTop_toBottomOf="@id/tvDetailsLabel" />

                <!-- 2. Email or Phone -->
                <EditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="Phone Number or Email"
                    android:textColorHint="#5C5670"
                    android:textColor="#FFFFFF"
                    android:inputType="text"
                    android:paddingStart="16dp"
                    android:textSize="14sp"
                    app:layout_constraintTop_toBottomOf="@id/etName" />

                <!-- 3. Password -->
                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="Create Password"
                    android:textColorHint="#5C5670"
                    android:textColor="#FFFFFF"
                    android:inputType="textPassword"
                    android:paddingStart="16dp"
                    android:textSize="14sp"
                    app:layout_constraintTop_toBottomOf="@id/etEmail" />

                <!-- ================= NEW OTP SECTION ================= -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layoutOtpHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:layout_constraintTop_toBottomOf="@id/etPassword">

                    <TextView
                        android:id="@+id/tvOtpLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Enter 6-Digit OTP"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <TextView
                        android:id="@+id/btnGetOtp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Get OTP"
                        android:textColor="#FFCA28"
                        android:textStyle="bold"
                        android:paddingVertical="5dp"
                        android:paddingHorizontal="10dp"
                        android:background="@drawable/bg_circle_dark"
                        android:clickable="true"
                        android:focusable="true"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- 6 Separated OTP Input Boxes -->
                <LinearLayout
                    android:id="@+id/otpContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp"
                    android:weightSum="6"
                    app:layout_constraintTop_toBottomOf="@id/layoutOtpHeader">

                    <EditText android:id="@+id/otp1" android:layout_width="0dp" android:layout_height="55dp" android:layout_weight="1" android:layout_marginHorizontal="4dp" android:background="@drawable/bg_input_field" android:gravity="center" android:inputType="number" android:maxLength="1" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" />
                    <EditText android:id="@+id/otp2" android:layout_width="0dp" android:layout_height="55dp" android:layout_weight="1" android:layout_marginHorizontal="4dp" android:background="@drawable/bg_input_field" android:gravity="center" android:inputType="number" android:maxLength="1" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" />
                    <EditText android:id="@+id/otp3" android:layout_width="0dp" android:layout_height="55dp" android:layout_weight="1" android:layout_marginHorizontal="4dp" android:background="@drawable/bg_input_field" android:gravity="center" android:inputType="number" android:maxLength="1" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" />
                    <EditText android:id="@+id/otp4" android:layout_width="0dp" android:layout_height="55dp" android:layout_weight="1" android:layout_marginHorizontal="4dp" android:background="@drawable/bg_input_field" android:gravity="center" android:inputType="number" android:maxLength="1" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" />
                    <EditText android:id="@+id/otp5" android:layout_width="0dp" android:layout_height="55dp" android:layout_weight="1" android:layout_marginHorizontal="4dp" android:background="@drawable/bg_input_field" android:gravity="center" android:inputType="number" android:maxLength="1" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" />
                    <EditText android:id="@+id/otp6" android:layout_width="0dp" android:layout_height="55dp" android:layout_weight="1" android:layout_marginHorizontal="4dp" android:background="@drawable/bg_input_field" android:gravity="center" android:inputType="number" android:maxLength="1" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" />
                </LinearLayout>

                <!-- =================================================== -->

                <!-- SIGN UP BUTTON -->
                <android.widget.Button
                    android:id="@+id/btnSignUp"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="25dp"
                    android:text="Sign Up"
                    android:textAllCaps="false"
                    android:textColor="#FF000000"
                    android:textStyle="bold"
                    android:background="@drawable/bg_btn_light"
                    app:layout_constraintTop_toBottomOf="@id/otpContainer" />

                <!-- TERMS & CONDITIONS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="20dp"
                    app:layout_constraintTop_toBottomOf="@id/btnSignUp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">
                        <RadioButton
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:scaleX="0.8"
                            android:scaleY="0.8"
                            android:buttonTint="#FFFFFF"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tutrnav is designed to connect teachers and students..."
                            android:textColor="#B0B0B0"
                            android:textSize="10sp"
                            android:paddingEnd="10dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <RadioButton
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:scaleX="0.8"
                            android:scaleY="0.8"
                            android:buttonTint="#2E2345"
                            android:backgroundTint="#2E2345"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="By downloading, accessing, or using this application..."
                            android:textColor="#B0B0B0"
                            android:textSize="10sp"
                            android:paddingEnd="10dp"/>
                    </LinearLayout>

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>